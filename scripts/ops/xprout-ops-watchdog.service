[Unit]
Description=Xprout dedicated Telegram host and container checks
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/xprout-ops.env
ExecStart=/usr/bin/python3 -B /opt/xprout-ops/telegram-host-watchdog.py
StateDirectory=xprout-ops
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ReadWritePaths=/var/lib/xprout-ops
